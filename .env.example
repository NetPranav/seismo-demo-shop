# Fake third-party providers (Hackwave3.0/services, `npm run dev -w services` -> port 4100)
USERS_API_URL=http://localhost:4100
PAYMENTS_API_URL=http://localhost:4100
SHIPPING_API_URL=http://localhost:4100
ORDERS_API_URL=http://localhost:4100
# Seismo backend + SDK key (leave SEISMO_KEY empty to run the shop without Seismo)
SEISMO_ENDPOINT=http://localhost:4050
SEISMO_KEY=dev-key
# Demo panel (bottom-right): flips the fake providers and shows what Seismo detected. Never in production.
DEMO_PANEL=false
DEMO_ADMIN_TOKEN=
NEXT_PUBLIC_SEISMO_DASHBOARD_URL=http://localhost:3000
